# Configuration for the checkout service. Copy to .env (git-ignored) for local
# runs and load it with:
#   node --env-file=.env --require ./instrumentation.cjs server.cjs
# In deployments these come from the environment; the ingestion key comes from
# the secret store and never goes in the repository.

# Port the service listens on.
PORT=8080

# Base URL of the inventory service. Leave unset to skip stock reservation.
# INVENTORY_URL=

# Probin metrics. With OTEL_EXPORTER_OTLP_ENDPOINT unset the service runs without exporting.
OTEL_SERVICE_NAME=checkout
# The workspace's ingestion URL, from the Probin workspace settings.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Secret. Replace the placeholder in your untracked .env only.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <ingestion key>
