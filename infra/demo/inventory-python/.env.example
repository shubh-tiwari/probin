# Probin metrics. Copy to .env (git-ignored) for local runs; in deployments these come from
# the deployment's configuration and secret store. If OTEL_EXPORTER_OTLP_ENDPOINT is not set
# the service runs normally and exports nothing.

# The service's short name. Must match `service` in probin.yaml.
OTEL_SERVICE_NAME=inventory

# The workspace's ingestion URL, from the Probin workspace settings.
OTEL_EXPORTER_OTLP_ENDPOINT=<ingestion URL from the Probin workspace settings>
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# SECRET. Never commit the real key; take it from the deployment's secret store.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <ingestion key>

# Optional, for checking locally: print metrics to the console instead of sending them.
# OTEL_METRICS_EXPORTER=console
# OTEL_METRIC_EXPORT_INTERVAL=5000
