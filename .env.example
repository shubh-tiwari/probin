# Local development settings. `make dev` copies this file to .env if .env is missing.
# No secrets belong in this file; real keys come from the environment.

# Postgres (spec store, catalog, memory, accounts, job queue).
# The host port is not 5432 so it does not collide with a Postgres already on this machine.
# If you change POSTGRES_PORT, change the port in DATABASE_URL to match.
POSTGRES_PORT=54320
DATABASE_URL=postgres://app:app@localhost:54320/app

# Metrics store. Reached only through the Prometheus-compatible query API.
# METRICS_STORE_TYPE: victoriametrics | prometheus
METRICS_STORE_TYPE=victoriametrics
METRICS_STORE_PORT=8428
METRICS_STORE_URL=http://localhost:8428

# Ingestion endpoint: where services send OTLP over HTTP and register manifests.
INGEST_PORT=4318
INGEST_URL=http://localhost:4318

# The collector behind the ingestion endpoint is private. Only its health port is published.
COLLECTOR_HEALTH_PORT=13133

# Query API: the only service that talks to the metrics store.
QUERY_API_PORT=8090
QUERY_API_URL=http://localhost:8090
QUERY_TIMEOUT_MS=10000
QUERY_MAX_LINES=50
QUERY_CACHE_TTL_SECONDS=15

# Agent service: the one agent behind Slack, the web tool and Review.
AGENT_PORT=8091
AGENT_URL=http://localhost:8091
# The range a new dashboard gets, and the range a query is tested over when a request gives none.
DEFAULT_DASHBOARD_RANGE=6h

# Slack app. In development the app talks to a local fake Slack, so these are dev-only values.
# For a real Slack app, see docs/runbooks/phase-2.md.
SLACK_PORT=8092
SLACK_PUBLIC_URL=http://localhost:8092
SLACK_SIGNING_SECRET=dev-only-signing-secret
SLACK_CLIENT_ID=dev-only-client-id
SLACK_CLIENT_SECRET=dev-only-client-secret
SLACK_FAKE_PORT=8093
SLACK_FAKE_URL=http://localhost:8093
SLACK_API_URL=http://localhost:8093/api
SLACK_AUTHORIZE_URL=http://localhost:8093/oauth/v2/authorize
SLACK_OPENID_AUTHORIZE_URL=http://localhost:8093/openid/connect/authorize

# The web tool.
WEB_PORT=8094
WEB_URL=http://localhost:8094

# Stripe. In development the web tool talks to a local fake Stripe; these are dev-only values.
STRIPE_SECRET_KEY=sk_test_dev_only_not_a_secret
STRIPE_WEBHOOK_SECRET=whsec_dev_only_not_a_secret
STRIPE_FAKE_PORT=8095
STRIPE_FAKE_URL=http://localhost:8095
STRIPE_API_URL=http://localhost:8095
# Development only: delete a cancelled workspace's data after 20 seconds, not the plan's grace period.
DELETION_GRACE_SECONDS=20

# GitHub App, for Review. In development Review talks to a local fake GitHub.
# `make dev` writes a development-only key to .dev-secrets/; it is mounted, never committed.
GITHUB_APP_ID=12345
GITHUB_WEBHOOK_SECRET=dev-only-github-webhook-secret
GITHUB_FAKE_PORT=8096
GITHUB_FAKE_URL=http://localhost:8096
GITHUB_APP_INSTALL_URL=http://localhost:8096/fake/install
REVIEW_PORT=8097
REVIEW_URL=http://localhost:8097
# Review reads the last REVIEW_WINDOW of data, and compares REVIEW_DEPLOY_WINDOW before and after a deploy.
REVIEW_WINDOW=24h
REVIEW_DEPLOY_WINDOW=2m

# Encrypts secrets stored in the database (Slack bot tokens). 32 bytes, base64.
# This value is for local development only and is not a secret. Deployments set their own.
SECRETS_KEY=ZGV2LW9ubHktc2VjcmV0cy1rZXktbm90LXNlY3JldCE=

# Shared secret for calls between our own services.
# This value is for local development only. Deployments set their own.
INTERNAL_API_TOKEN=dev-only-internal-token-not-a-secret

# Local development only: the workspace `make dev` seeds, and its ingestion key.
# The demo services send with this key. It is not a secret and works nowhere else.
DEV_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
DEV_INGESTION_KEY=dev-only-ingestion-key-not-a-secret

# Demo services
DEMO_CHECKOUT_PORT=8081
DEMO_INVENTORY_PORT=8082

# Models. Leave the key empty to run without model calls; set it to use OpenRouter.
# Never commit a real key.
OPENROUTER_API_KEY=
MODELS_FILE=config/models.example.yaml

# Plans, limits and prices are read from this file. Nothing about them is hard-coded.
PLANS_FILE=config/plans.example.yaml
